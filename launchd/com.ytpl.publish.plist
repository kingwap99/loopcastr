<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ytpl.publish</string>

    <!-- 推流端：單一長命 publisher 從 MediaMTX 的 live/main 推到 YouTube ingest。
         上游怎麼換手都只發生在 MediaMTX 內部，YouTube 端只看到這一條連線。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/ytpl/yt_publish.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SRC</key>
        <string>rtmp://127.0.0.1:1935/live/main</string>
        <key>API</key>
        <string>http://127.0.0.1:9997</string>
        <key>KEYFILE</key>
        <string>__HOME__/ytpl/stream.key</string>
        <key>PUSH_URL</key>
        <string>rtmp://a.rtmp.youtube.com/live2</string>
        <key>LOG</key>
        <string>__HOME__/ytpl/logs/publish.log</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__HOME__/ytpl/logs/publish-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/ytpl/logs/publish-stderr.log</string>
</dict>
</plist>
