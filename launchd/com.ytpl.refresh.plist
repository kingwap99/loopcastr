<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.ytpl.refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3</string>
		<string>__HOME__/ytpl/refreshwatch.py</string>
		<string>--mode</string>
		<string>auto</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/ytpl/logs/refreshwatch.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/ytpl/logs/refreshwatch.out.log</string>
	<key>WorkingDirectory</key>
	<string>__HOME__/ytpl</string>
</dict>
</plist>
