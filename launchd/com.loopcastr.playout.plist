<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.loopcastr.playout</string>

    <!-- Playout: one single concat process feeds MediaMTX. Measured 0 gaps at segment changes and at the wrap back to the top. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/loopcastr/playout.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PLAYLIST</key>
        <string>__HOME__/loopcastr/playlist-local.json</string>
        <key>LIST</key>
        <string>__HOME__/loopcastr/concat.txt</string>
        <key>DEST</key>
        <string>rtmp://127.0.0.1:1935/live/main</string>
        <key>LOG</key>
        <string>__HOME__/loopcastr/logs/playout.log</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Keep live encoding from being throttled by App Nap / scheduler pressure -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__HOME__/loopcastr/logs/playout-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/loopcastr/logs/playout-stderr.log</string>
</dict>
</plist>
