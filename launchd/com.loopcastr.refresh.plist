<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.loopcastr.refresh</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__PYTHON_PATH__</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__HOME__/loopcastr/refreshwatch.py</string>
		<string>--mode</string>
		<string>auto</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/loopcastr/logs/refreshwatch.err.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/loopcastr/logs/refreshwatch.out.log</string>
	<key>WorkingDirectory</key>
	<string>__HOME__/loopcastr</string>
</dict>
</plist>
