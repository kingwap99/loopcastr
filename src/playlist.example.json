{
  "_comment": "母清單範例。實際要用的是 build_playlist.py 產生的 playlist.json：python3 build_playlist.py --url '<播放清單或頻道網址>' -o playlist.json。下面三筆的影片 id 是假的，換成真的才能播；seconds 是長度（秒），build_local_content.py 會用它核對下載結果是不是完整的一支。",
  "target": "rtmp://127.0.0.1:1935/live/main",
  "clients": [
    "web_embedded",
    "mweb",
    "default",
    "android_vr"
  ],
  "segments": [
    {
      "id": "AAAAAAAAAAA",
      "type": "vod",
      "url": "https://www.youtube.com/watch?v=AAAAAAAAAAA",
      "format": "bv*[height<=720][ext=mp4]+ba[ext=m4a]/b[height<=720]/b",
      "mode": "copy",
      "seconds": 271
    },
    {
      "id": "BBBBBBBBBBB",
      "type": "vod",
      "url": "https://www.youtube.com/watch?v=BBBBBBBBBBB",
      "format": "bv*[height<=720][ext=mp4]+ba[ext=m4a]/b[height<=720]/b",
      "mode": "copy",
      "seconds": 227
    },
    {
      "id": "CCCCCCCCCCC",
      "type": "vod",
      "url": "https://www.youtube.com/watch?v=CCCCCCCCCCC",
      "format": "bv*[height<=720][ext=mp4]+ba[ext=m4a]/b[height<=720]/b",
      "mode": "copy",
      "seconds": 180
    }
  ]
}

